      <column caption='First Purchase Date' datatype='date' name='[Calculation_920986128783691776]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id]: MIN([payment_date]) }' />
      </column>
      <column caption='Cohort Month' datatype='date' name='[Calculation_920986128784900097]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_920986128783691776]))' />
      </column>
      <column caption='Months Since First Purchase' datatype='integer' name='[Calculation_920986128785403906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_920986128783691776], [payment_date])' />
      </column>
      <column caption='Customer Retention' datatype='integer' name='[Calculation_920986128786472963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_920986128785403906] &gt;= 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_920986128786948100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_920986128786472963]) / COUNTD([customer_id])' />
      </column>
